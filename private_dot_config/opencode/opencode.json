{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "bunx tsc --noEmit": "allow",
      "bunx eslint *": "allow",
      "bun run lint *": "allow",
      "bun run build *": "allow",
      "bun run typegen *": "allow",
      "npm run lint *": "allow",
      "npm run build *": "allow",
      "npx tsc --noEmit": "allow",
      "npx vitest run *": "allow",
      "npx eslint *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rm *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "mcp": {
    "sanity": {
      "type": "remote",
      "url": "https://mcp.sanity.io",
      "enabled": true
    }
  }
}
