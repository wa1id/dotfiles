{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-claude-auth"],
  "permission": {
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git fetch *": "allow",
      "git rev-parse *": "allow",
      "git worktree list": "allow",
      "git remote -v": "allow",
      "git rev-list *": "allow",
      "git merge-base --is-ancestor *": "allow",
      "chezmoi source-path": "allow",
      "chezmoi source-path *": "allow",
      "chezmoi status": "allow",
      "chezmoi managed *": "allow",
      "chezmoi diff *": "allow",
      "chezmoi update --help": "allow",
      "chezmoi git -- status": "allow",
      "chezmoi git -- status *": "allow",
      "chezmoi git -- remote -v": "allow",
      "chezmoi git -- rev-list *": "allow",
      "chezmoi git -- log *": "allow",
      "bunx tsc --noEmit": "allow",
      "bunx eslint *": "allow",
      "bun run lint *": "allow",
      "bun run build *": "allow",
      "bun run typegen *": "allow",
      "bun add *": "allow",
      "npm run lint *": "allow",
      "npm run lint:fix *": "allow",
      "npm run build *": "allow",
      "npm test *": "allow",
      "npm run test:compact *": "allow",
      "npx tsc --noEmit": "allow",
      "npx vitest run *": "allow",
      "npx eslint *": "allow",
      "npm run typecheck *": "allow",
      "npm ls *": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "printf *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "head *": "allow",
      "rm *": "ask",
      "go test *": "allow",
      "gofmt *": "allow",
      "sqlc generate": "allow",
      "gh pr status *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "mcp": {
    "sanity": {
      "type": "remote",
      "url": "https://mcp.sanity.io",
      "enabled": true
    }
  }
}
